{
	"name": "refinery",
	"private": true,
	"version": "1.1.6",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1",
			"onFail": "download"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && NODE_OPTIONS=--max-semi-space-size=256 eslint --cache --cache-location node_modules .",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:run": "node scripts/run-migrations.js",
		"db:studio": "drizzle-kit studio",
		"zero:generate": "drizzle-zero generate --config drizzle-zero.config.ts --format --output src/lib/zero/zero-schema.gen.ts",
		"zero:start": "zero-cache-dev",
		"screenshots": "node scripts/take-screenshots.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.577.0",
		"@node-rs/argon2": "^2.2.1",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@rocicorp/zero": "^1.9.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "~2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.9",
		"arctic": "^3.7.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-zero": "^0.20.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"formsnap": "^2.0.1",
		"fuse.js": "^7.5.0",
		"globals": "^17.13.0",
		"mode-watcher": "^1.1.0",
		"pino-pretty": "^13.2.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"uuid": "^14.0.2",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.2",
		"vite-plugin-devtools-json": "^1.1.0",
		"vite-plugin-lucide-preprocess": "^1.8.0",
		"zero-svelte": "~2.0.1"
	},
	"dependencies": {
		"@atproto/api": "^0.23.1",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@kubiks/otel-drizzle": "^2.1.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.222.0",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@opentelemetry/context-zone": "^2.11.0",
		"@opentelemetry/core": "^2.11.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
		"@opentelemetry/instrumentation": "^0.222.0",
		"@opentelemetry/instrumentation-document-load": "^0.67.0",
		"@opentelemetry/instrumentation-fetch": "^0.222.0",
		"@opentelemetry/instrumentation-pino": "^0.68.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-logs": "^0.222.0",
		"@opentelemetry/sdk-node": "^0.222.0",
		"@opentelemetry/sdk-trace-web": "^2.11.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"drizzle-orm": "^0.45.3",
		"import-in-the-middle": "^3.5.2",
		"pino": "~10.3.1",
		"postgres": "^3.4.9",
		"runed": "^0.37.1",
		"valibot": "^1.5.0"
	}
}
