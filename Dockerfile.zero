# Zero Cache Server
# Uses the official zero-cache image, which carries Rocicorp's dependency patches
# and is versioned independently of the app lockfile. Keep the tag in sync with
# @rocicorp/zero in package.json; upgrade this image before the app/client so
# zero-cache is never older than the clients talking to it.
FROM rocicorp/zero:1.9.0@sha256:f80683bf3ddf08be26c68ddd94589fada29a0b8a4597668b090006c09041d4cd
