{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"noUncheckedIndexedAccess": true,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		"*.js",
		"*.ts",
		"scripts/**/*.ts",
		"scripts/**/*.js",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.js",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte"
	],
	"exclude": ["node_modules/**", "src/service-worker.js", "src/service-worker.d.ts"]
}
